# ── Alpha Hive environment template ───────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# Deployment: "development" | "production".
# In production the app REFUSES to start with a weak SECRET_KEY or CORS_ORIGINS=*.
ENVIRONMENT=development

# ── Auth / sessions ───────────────────────────────────────────────────────────
# Signs the httpOnly session cookie. Rotating it signs everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-48-byte-random-string
SESSION_TTL_DAYS=365
# Forced on in production. Leave false for http://localhost.
COOKIE_SECURE=false

# ── Database — Supabase (or any managed Postgres) ─────────────────────────────
# Supabase > Project Settings > Database > Connection string > URI.
# Swap `postgresql://` for `postgresql+asyncpg://`.
#   Direct  (long-lived servers): db.<ref>.supabase.co:5432
#   Pooler  (serverless / many short-lived conns): aws-0-<region>.pooler.supabase.com:6543
#                                 user becomes postgres.<ref>
# app/db/session.py detects the pooler and disables prepared statements + pooling.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Only used to assemble a URL if DATABASE_URL above is omitted.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Supabase project keys. Not read by the backend (auth is handled in FastAPI) — kept
# for the Supabase CLI/dashboard. NEVER commit the secret key.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ── Redis — required (chat streaming, rate limiting, token budget, caching) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── LLM — LiteLLM-compatible proxy (provider-agnostic). Required for real analysis ──
LITELLM_BASE_URL=https://your-litellm-proxy/v1
LITELLM_API_KEY=sk-...
LLM_MODEL_PRIMARY=google/gemini-3.5-flash        # fast tier: specialist agents
LLM_MODEL_FALLBACK=anthropic/claude-haiku-4-5     # used if primary errors/times out
LLM_MODEL_SYNTHESIS=anthropic/claude-sonnet-4-6   # stronger tier: planning + final decision
# Semantic SEC-filing search. Leave empty to rank by Postgres full-text search instead.
EMBEDDING_MODEL=

# ── Market data (all free-tier) ───────────────────────────────────────────────
FINNHUB_API_KEY=your-finnhub-key
TWELVE_DATA_API_KEY=your-twelve-data-key
MARKETAUX_API_KEY=your-marketaux-key              # optional but recommended (Indian news)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key      # optional

# ── Cost control ──────────────────────────────────────────────────────────────
MAX_TOKENS_PER_SESSION=100000

# ── Networking / security ─────────────────────────────────────────────────────
# The frontend proxies /svc/api to the backend, so requests are same-origin and CORS
# is effectively unused. In production this must still be your exact origin(s), never *.
CORS_ORIGINS=*
# Trust X-Forwarded-For for rate limiting. True behind nginx / a load balancer,
# false if the app is exposed directly to the internet.
TRUST_PROXY_HEADERS=true

# ── Frontend ──────────────────────────────────────────────────────────────────
# Where Next.js proxies /svc/api. Docker Compose overrides this to http://backend:8000.
BACKEND_URL=http://127.0.0.1:8000
# Leave EMPTY unless the backend is on a different origin than the frontend.
NEXT_PUBLIC_API_URL=
# Used for canonical URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
